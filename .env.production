# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL ENVIRONMENT (For local-only setup)
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (Local)
# URL: http://localhost:4000
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://localhost:4000

# Database (Local PostgreSQL)
DATABASE_URL=postgresql://securelens:securelens@localhost:5433/securelens

# Redis (Local)
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=your_secure_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRATION=24h

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Local)
# Production: http://localhost:3000
# Preview: http://localhost:3001
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# CORS Origins - Local URLs only
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# OAuth Configuration (Local Development)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_local_github_client_id
GITHUB_CLIENT_SECRET=your_local_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

GOOGLE_CLIENT_ID=your_local_google_client_id
GOOGLE_CLIENT_SECRET=your_local_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Frontend Redirect URLs for OAuth
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Logging (Development)
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_PRETTY_LOGS=true

# ─────────────────────────────────────────────────────────────────────────────
# Security Scanners (Development)
# ─────────────────────────────────────────────────────────────────────────────
SCANNER_TIMEOUT=300000
NUCLEI_ENABLED=true
TRIVY_ENABLED=true
ZAP_ENABLED=true
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
NMAP_ENABLED=true
WHATWEB_ENABLED=true
TESTSSL_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Worker Configuration (Development)
# ─────────────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_TIMEOUT=600000
WORKER_PROCESS_INTERVAL=5000
