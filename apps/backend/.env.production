# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT - Backend
# URL: http://localhost:4000
# ═══════════════════════════════════════════════════════════════════════════════

# Environment
NODE_ENV=development
PORT=4000

# Backend URL (for OAuth and redirects)
BACKEND_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# Database (Local PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://securelens:securelens@localhost:5433/securelens

# ─────────────────────────────────────────────────────────────
# Redis (Local)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─────────────────────────────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your_secure_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRATION=24h

# ─────────────────────────────────────────────────────────────
# Frontend Configuration (for CORS & OAuth redirects)
# ─────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# GitHub OAuth (Configure in local development)
# ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# ─────────────────────────────────────────────────────────────
# Google OAuth (Configure in local development)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_PRETTY_LOGS=true

# ─────────────────────────────────────────────────────────────
# Security Scanners (Enabled for development)
# ─────────────────────────────────────────────────────────────
SCANNER_TIMEOUT=300000
NUCLEI_ENABLED=true
TRIVY_ENABLED=true
ZAP_ENABLED=true
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
NMAP_ENABLED=true
WHATWEB_ENABLED=true
TESTSSL_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Worker Configuration
# ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_TIMEOUT=600000
WORKER_PROCESS_INTERVAL=5000
